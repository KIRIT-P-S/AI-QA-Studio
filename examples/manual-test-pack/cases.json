        "target": "#product-keyboard .product-title",
        "expected": "Mechanical Keyboard"
      },
      {
        "action": "assertText",
        "target": "#product-headphones .product-title",
        "expected": "Studio Headphones"
      },
      {
        "action": "assertText",
        "target": "#product-mouse .price",
        "expected": "₹799"
      },
      {
        "action": "assertText",
        "target": "#product-keyboard .price",
        "expected": "₹1299"
      },
      {
        "action": "assertText",
        "target": "#product-headphones .price",
        "expected": "₹2499"
      },
      {
        "action": "assertVisible",
        "target": "#view-mouse"
      },
      {
        "action": "assertVisible",
        "target": "#view-keyboard"
      },
      {
        "action": "assertVisible",
        "target": "#view-headphones"
      }
    ],
    "natural": "Open the homepage. Verify Shop QA Demo, product count 3, Wireless Mouse priced ₹799, Mechanical Keyboard priced ₹1299, Studio Headphones priced ₹2499 and a visible View details link for each product."
  },
  {
