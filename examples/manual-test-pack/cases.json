  {
    "title": "TC07 Add Wireless Mouse",
    "expected": "Adding Wireless Mouse once changes fresh cart count 0 to 1 and displays Added to cart.",
    "kind": "Functional",
    "steps": [
      {
        "action": "navigate",
        "target": "/products/mouse"
      },
      {
        "action": "assertText",
        "target": "#cart-count",
        "expected": "0"
      },
      {
        "action": "click",
        "target": "#add-to-cart"
      },
      {
        "action": "assertText",
        "target": "#cart-count",
        "expected": "1"
      },
      {
        "action": "assertText",
        "target": "#cart-message",
        "expected": "Added to cart"
      }
    ],
    "natural": "Open a fresh /products/mouse page and verify cart count 0. Click Add to cart once, then verify cart count 1 and the visible confirmation Added to cart. Retain these expected values even if the application has a defect."
  },
