        "action": "navigate",
        "target": "/"
      },
      {
        "action": "fill",
        "target": "#query",
        "value": "wireless mouse"
      },
      {
        "action": "assertValue",
        "target": "#query",
        "expected": "wireless mouse"
      },
      {
        "action": "assertVisible",
        "target": "#search-button"
      }
    ],
    "natural": "Open the homepage, enter wireless mouse in the Search products field, verify its exact input value before submission and verify the Search button is visible."
  },
  {
